rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isCurrency(val) {
      return val is string && val in ['USD', 'EUR', 'GBP', 'INR'];
    }

    function isLanguage(val) {
      return val is string && val in ['en', 'es', 'fr', 'hi'];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'currency', 'language',
          'allowanceAmountCents', 'nextAllowanceIso', 'cycleDays', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'university', 'currency', 'language',
          'allowanceAmountCents', 'nextAllowanceIso', 'cycleDays', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('university' in data) || (data.university is string && data.university.size() <= 100))
        && isCurrency(data.currency)
        && isLanguage(data.language)
        && data.allowanceAmountCents is int && data.allowanceAmountCents >= 0 && data.allowanceAmountCents <= 100000000
        && data.nextAllowanceIso is string && data.nextAllowanceIso.size() >= 8 && data.nextAllowanceIso.size() <= 40
        && data.cycleDays is int && data.cycleDays >= 7 && data.cycleDays <= 90
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccount(data, userId, accountId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'type', 'currency', 'balanceCents', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'type', 'currency', 'balanceCents', 'institution', 'lastFour', 'updatedAt'])
        && data.id is string && data.id == accountId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.type is string && data.type in ['checking', 'savings', 'campus_card', 'cash']
        && isCurrency(data.currency)
        && data.balanceCents is int && data.balanceCents >= -100000000 && data.balanceCents <= 1000000000
        && (!('institution' in data) || (data.institution is string && data.institution.size() <= 60))
        && (!('lastFour' in data) || (data.lastFour is string && data.lastFour.size() <= 4))
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data, userId, txId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'accountId', 'type', 'status', 'amountCents',
          'currency', 'category', 'merchant', 'occurredAtUtc', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'accountId', 'type', 'status', 'amountCents',
          'currency', 'category', 'merchant', 'note', 'occurredAtUtc', 'idempotencyKey', 'createdAt'
        ])
        && data.id is string && data.id == txId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.accountId is string && isValidId(data.accountId)
        && data.type is string && data.type in ['expense', 'income', 'transfer']
        && data.status is string && data.status in ['pending', 'posted', 'reversed', 'failed']
        && data.amountCents is int && data.amountCents > 0 && data.amountCents <= 100000000
        && isCurrency(data.currency)
        && data.category is string && data.category in ['dining', 'groceries', 'transport', 'textbooks', 'subscriptions', 'fun', 'rent', 'income', 'savings']
        && data.merchant is string && data.merchant.size() >= 1 && data.merchant.size() <= 80
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.occurredAtUtc is string && data.occurredAtUtc.size() >= 10 && data.occurredAtUtc.size() <= 40
        && (!('idempotencyKey' in data) || (data.idempotencyKey is string && data.idempotencyKey.size() <= 120))
        && data.createdAt is timestamp;
    }

    function isValidBudget(data, userId, budgetId) {
      return data.keys().hasAll(['id', 'ownerId', 'category', 'limitCents', 'currency', 'monthKey', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'category', 'limitCents', 'currency', 'monthKey', 'updatedAt'])
        && data.id is string && data.id == budgetId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.category is string && data.category in ['dining', 'groceries', 'transport', 'textbooks', 'subscriptions', 'fun', 'rent']
        && data.limitCents is int && data.limitCents > 0 && data.limitCents <= 100000000
        && isCurrency(data.currency)
        && data.monthKey is string && data.monthKey.size() >= 6 && data.monthKey.size() <= 10
        && data.updatedAt is timestamp;
    }

    function isValidVault(data, userId, vaultId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'artworkKey', 'targetCents', 'savedCents', 'currency', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'artworkKey', 'targetCents', 'savedCents', 'weeklyAutoCents', 'currency', 'targetDateIso', 'contributions', 'updatedAt'])
        && data.id is string && data.id == vaultId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 60
        && data.artworkKey is string && data.artworkKey in ['laptop', 'trip', 'emergency']
        && data.targetCents is int && data.targetCents > 0 && data.targetCents <= 1000000000
        && data.savedCents is int && data.savedCents >= 0 && data.savedCents <= 1000000000
        && (!('weeklyAutoCents' in data) || (data.weeklyAutoCents is int && data.weeklyAutoCents >= 0 && data.weeklyAutoCents <= 100000000))
        && isCurrency(data.currency)
        && (!('targetDateIso' in data) || (data.targetDateIso is string && data.targetDateIso.size() <= 40))
        && (!('contributions' in data) || (data.contributions is list && data.contributions.size() <= 50))
        && data.updatedAt is timestamp;
    }

    function isValidRecurring(data, userId, ruleId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'type', 'category', 'amountCents', 'currency', 'cadence', 'nextDueIso', 'active'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'type', 'category', 'amountCents', 'currency', 'cadence', 'nextDueIso', 'active'])
        && data.id is string && data.id == ruleId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 60
        && data.type is string && data.type in ['expense', 'income']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 30
        && data.amountCents is int && data.amountCents > 0 && data.amountCents <= 100000000
        && isCurrency(data.currency)
        && data.cadence is string && data.cadence in ['weekly', 'monthly']
        && data.nextDueIso is string && data.nextDueIso.size() >= 8 && data.nextDueIso.size() <= 40
        && data.active is bool;
    }

    function isValidCircle(data, userId, circleId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'currency', 'members', 'expenses', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'themeColor', 'currency', 'members', 'expenses', 'updatedAt'])
        && data.id is string && data.id == circleId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && (!('themeColor' in data) || (data.themeColor is string && data.themeColor.size() <= 20))
        && isCurrency(data.currency)
        && data.members is list && data.members.size() >= 1 && data.members.size() <= 20
        && data.expenses is list && data.expenses.size() <= 100
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'university', 'currency', 'language',
          'allowanceAmountCents', 'nextAllowanceIso', 'cycleDays', 'updatedAt'
        ]);
      allow delete: if false;

      match /accounts/{accountId} {
        allow get: if isValidId(userId) && isValidId(accountId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId) && isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(accountId)
          && isVerifiedOwner(userId)
          && isValidAccount(incoming(), userId, accountId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(accountId)
          && isVerifiedOwner(userId)
          && isValidAccount(incoming(), userId, accountId)
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'balanceCents', 'institution', 'lastFour', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(accountId) && isVerifiedOwner(userId);
      }

      match /transactions/{txId} {
        allow get: if isValidId(userId) && isValidId(txId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId) && isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(txId)
          && isVerifiedOwner(userId)
          && isValidTransaction(incoming(), userId, txId)
          && incoming().createdAt == request.time;
        allow update: if isValidId(userId) && isValidId(txId)
          && isVerifiedOwner(userId)
          && isValidTransaction(incoming(), userId, txId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().amountCents == existing().amountCents
          && existing().status != 'reversed'
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'note', 'category']);
        allow delete: if false;
      }

      match /budgets/{budgetId} {
        allow get: if isValidId(userId) && isValidId(budgetId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId) && isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(budgetId)
          && isVerifiedOwner(userId)
          && isValidBudget(incoming(), userId, budgetId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(budgetId)
          && isVerifiedOwner(userId)
          && isValidBudget(incoming(), userId, budgetId)
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['limitCents', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(budgetId) && isVerifiedOwner(userId);
      }

      match /vaults/{vaultId} {
        allow get: if isValidId(userId) && isValidId(vaultId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId) && isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(vaultId)
          && isVerifiedOwner(userId)
          && isValidVault(incoming(), userId, vaultId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(vaultId)
          && isVerifiedOwner(userId)
          && isValidVault(incoming(), userId, vaultId)
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'targetCents', 'savedCents', 'weeklyAutoCents', 'targetDateIso', 'contributions', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(vaultId) && isVerifiedOwner(userId);
      }

      match /recurring/{ruleId} {
        allow get: if isValidId(userId) && isValidId(ruleId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId) && isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(ruleId)
          && isVerifiedOwner(userId)
          && isValidRecurring(incoming(), userId, ruleId);
        allow update: if isValidId(userId) && isValidId(ruleId)
          && isVerifiedOwner(userId)
          && isValidRecurring(incoming(), userId, ruleId)
          && incoming().ownerId == existing().ownerId
          && incoming().diff(existing()).affectedKeys().hasOnly(['active', 'nextDueIso', 'amountCents']);
        allow delete: if isValidId(userId) && isValidId(ruleId) && isVerifiedOwner(userId);
      }

      match /circles/{circleId} {
        allow get: if isValidId(userId) && isValidId(circleId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId) && isVerifiedOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(circleId)
          && isVerifiedOwner(userId)
          && isValidCircle(incoming(), userId, circleId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(circleId)
          && isVerifiedOwner(userId)
          && isValidCircle(incoming(), userId, circleId)
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'members', 'expenses', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(circleId) && isVerifiedOwner(userId);
      }
    }
  }
}
